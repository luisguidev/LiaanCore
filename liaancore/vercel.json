{
  "builds": [
    {
      "src": "liaancore/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10"
      }
    }
  ],
  "routes": [
    
    {
      "src": "/static/(.*)",
      "dest": "liaancore/wsgi.py"
    },
    
    {
      "src": "/(.*)",
      "dest": "liaancore/wsgi.py"
    }
  ]
}