{
  "builds": [
    {
      "src": "liaancore/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "liaancore/wsgi.py" 
    }
  ],
  "build": {
    "env": {
      "PYTHON_VERSION": "3.10"
    }
  },
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python manage.py makemigrations Mapeamento && python manage.py migrate --noinput && python manage.py collectstatic --noinput"
}