{
  "version": 2,
  "builds": [
    {
      "src": "liaancore/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/*/",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.)",
      "dest": "liaancore/wsgi.py"
    }
  ]
}