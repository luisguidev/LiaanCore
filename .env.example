# Copie para .env e ajuste. NUNCA versione o .env preenchido.
#
#   cp .env.example .env

# --- Django ---
# Gere uma com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY='troque-esta-chave'
# False em producao: e o que ativa SSL, cookie secure e HSTS.
DEBUG='1'

# Dominios separados por virgula.
# OBRIGATORIO em producao: sem ALLOWED_HOSTS o Django sobe usando o host do
# RENDER_EXTERNAL_URL, e sem nenhum dos dois ele RECUSA subir (antes havia um
# fallback '.onrender.com', que aceitava qualquer subdomínio do Render).
# ALLOWED_HOSTS='liaancore.onrender.com'

# --- Banco de dados ---
# As credenciais abaixo sao usadas tanto pelo Django quanto pelo docker-compose.yml.
DB_NAME='postgres'
DB_USER='postgres'
DB_PASSWORD='postgres'
DB_HOST='localhost'
# Porta publicada pelo container na sua maquina. O padrao do compose e 5433
# porque a 5432 costuma estar ocupada por outros projetos.
DB_PORT='5433'

# --- Cadastro de usuario ---
# Chave da API do Resend (https://resend.com). Sem isso o cadastro nao envia email.
# RESEND_API_KEY='re_xxxxxxxxxxxxxxxx'
# Quem recebe o aviso de novo usuario cadastrado.
LIAAN_ADMIN_EMAIL='seu-email@exemplo.com'

# Remetente do aviso de cadastro.
#
# O padrao 'LiaanCore <onboarding@resend.dev>' SO funciona quando o
# destinatario (LIAAN_ADMIN_EMAIL) e o dono da conta Resend — a Resend rejeita
# esse remetente para qualquer outro endereco. Em producao, verifique um dominio
# e aponte para ele, senao o aviso nunca chega (a falha agora aparece no log).
# RESEND_FROM_EMAIL='LiaanCore <liaancore@seu-dominio.org>'

# --- Erros ---
# Quem recebe o relatorio de erro do Django (mail_admins). Varios, separados
# por virgula, no formato de email.
# DJANGO_ADMINS='Administrador <admin@seu-dominio.org>'
# Nivel dos logs: DEBUG, INFO, WARNING, ERROR.
# DJANGO_LOG_LEVEL='INFO'

# --- HTTPS (opcional) ---
# Padrao 31536000 (1 ano). Use 0 para desativar o HSTS.
# SECURE_HSTS_SECONDS='31536000'